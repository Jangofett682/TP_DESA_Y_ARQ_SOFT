@startuml 03_negocio
title CloudGaming — Capa de lógica de negocio (BLL)
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #B0E3E6
skinparam classBorderColor #0E8088
skinparam ArrowColor #000000
skinparam defaultFontName Arial
skinparam defaultFontSize 13
hide circle
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 95
class JuegoBusiness {
  - juegoDAO : JuegoDAO
  --
  + GetAll() : List<JuegoEntity>
  + Agregar(nuevoJuego : JuegoEntity) : void
  + AltaConjunta(listaJuegos : List<JuegoEntity>) : void
  + Eliminar(id : int) : void
}
class JugadorBusiness {
  - jugadorDAO : JugadorDAO
  --
  + GetAll() : List<JugadorEntity>
  + Agregar(nuevoJugador : JugadorEntity) : void
  + Autenticar(nombreUsuario : string) : JugadorEntity
  + CargarSaldo(nombreUsuario : string, montoACargar : double) : void
}
class ServidorBusiness {
  - servidorDAO : ServidorDAO
  - juegoDAO : JuegoDAO
  --
  - ObtenerGamaGPU(gpu : string) : int
  - ExtraerGB(registro : string) : int
  - ObtenerGamaCPU(gpu : string) : int
  + EsCompatible(servidor : ServidorEntity, juego : JuegoEntity) : bool
  + ObtenerCapacidadPuntos(servidor : ServidorEntity) : int
  + {static} ObtenerCostoPuntos(juego : JuegoEntity) : int
  + ObtenerServidoresCompatiblesDisponibles(idJuego : int, incluirSinCupo : bool = false) : List<ServidorEntity>
  + GetAll() : List<ServidorEntity>
}
class SesionBusiness {
  - aplicacionDAO : SesionDAO
  - servidorDAO : ServidorDAO
  - juegoDAO : JuegoDAO
  - jugadorDAO : JugadorDAO
  - servidorBusiness : ServidorBusiness
  - sesionDAO : SesionDAO
  --
  + GetAll() : List<SesionEntity>
  + ValidarReglasNegocio(sesion : SesionEntity) : void
  + GuardarSesion(nuevaSesion : SesionEntity) : void
  - PrepararCapacidad(sesion : SesionEntity) : ServidorEntity
  + GuardarConjunto(listaSesiones : List<SesionEntity>) : void
  + Eliminar(id : int) : void
  + Modificar(sesionModificada : SesionEntity) : void
  + ObtenerSesionesUsuarioActivo() : List<SesionEntity>
}
class SesionJugador {
  - {static} instancia : SesionJugador
  + JugadorUsuario : string
  + NombreUsuario : string
  + Email : string
  + SaldoDisponible : double
  + EsAdmin : bool
  --
  + {static} GetInstance() : SesionJugador
  + IniciarSesion(jugador : JugadorEntity) : void
  + CerrarSesion() : void
  + ActualizarSaldoDisponible(nuevoSaldo : double) : void
}
SesionBusiness --> ServidorBusiness : servidorBusiness
SesionBusiness ..> SesionJugador : actualiza / consulta
JugadorBusiness ..> SesionJugador : actualiza saldo
JuegoBusiness ..> ServidorBusiness : ObtenerCostoPuntos()

@enduml

@startuml 04_acceso_datos
title CloudGaming — Capa de acceso a datos (DAL)
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #B0E3E6
skinparam classBorderColor #0E8088
skinparam ArrowColor #000000
skinparam defaultFontName Arial
skinparam defaultFontSize 13
hide circle
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 95
class JuegoDAO {

  --
  + getAll() : List<JuegoEntity>
  + BuscarPorID(id : int) : JuegoEntity
  + BuscarPorTitulo(titulo : string) : JuegoEntity
  + Guardar(juego : JuegoEntity) : void
  + Eliminar(id : int) : void
}
class JugadorDAO {

  --
  + getAll() : List<JugadorEntity>
  + Guardar(jugador : JugadorEntity) : void
  + Autenticar(nombreUsuario : string) : JugadorEntity
  + ActualizarSaldo(nombreUsuario : string, nuevoSaldo : double) : void
}
class ServidorDAO {

  --
  + getAll() : List<ServidorEntity>
  + ObtenerServidoresConOcupacion(ahoraUtc : DateTime) : List<ServidorEntity>
  + ObtenerPorID(idServidor : int) : ServidorEntity
}
class SesionDAO {
  + servidorDAO : ServidorDAO
  --
  + getAll() : List<SesionEntity>
  + AltaConjunta(listaSesiones : List<SesionEntity>) : void
  + RegistrarSesionSaldo(sesion : SesionEntity, nuevoSaldo : double) : void
  - RegistrarCapacidad(db : CloudGamingContext, sesion : SesionEntity, sesionBD : Sesión) : void
  - ValidarPuntos(db : CloudGamingContext, sesion : Sesión, inicio : DateTime, fin : DateTime, capacidad : int) : void
  + BuscarPorID(id : int) : SesionEntity
  + Eliminar(id : int) : void
  + Modificar(sesionModificada : SesionEntity, nuevoSaldo : double) : void
  + ObtenerPorUsuario(nombreUsuario : string) : List<SesionEntity>
}
class DBConfigurations <<static>> {

  --
  + {static} GetConnectionString() : string
}
class CloudGamingContext {
  + Juego : DbSet<Juego>
  + Jugador : DbSet<Jugador>
  + Servidor : DbSet<Servidor>
  + Sesión : DbSet<Sesión>
  --
  + CloudGamingContext()
  + CloudGamingContext(options : DbContextOptions<CloudGamingContext>)
  + {static} EjecutarTransaccion(operacion : Action<CloudGamingContext>) : void
  # OnConfiguring(optionsBuilder : DbContextOptionsBuilder) : void
  # OnModelCreating(modelBuilder : ModelBuilder) : void
}
class DbContext <<EF Core>>
DbContext <|-- CloudGamingContext
CloudGamingContext ..> DBConfigurations : GetConnectionString()
SesionDAO --> ServidorDAO : servidorDAO
JuegoDAO ..> CloudGamingContext : consulta / persiste
class JuegoMapper <<referencia>> {
}
JuegoDAO ..> JuegoMapper : mapea
JugadorDAO ..> CloudGamingContext : consulta / persiste
class JugadorMapper <<referencia>> {
}
JugadorDAO ..> JugadorMapper : mapea
ServidorDAO ..> CloudGamingContext : consulta / persiste
class ServidorMapper <<referencia>> {
}
ServidorDAO ..> ServidorMapper : mapea
SesionDAO ..> CloudGamingContext : consulta / persiste
class SesionMapper <<referencia>> {
}
SesionDAO ..> SesionMapper : mapea

@enduml

