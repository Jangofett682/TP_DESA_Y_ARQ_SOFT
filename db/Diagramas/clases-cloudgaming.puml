' CloudGaming — Diagramas de clases del código actual.
' Referencia de sintaxis: https://plantuml.com/class-diagram
' Cada bloque @startuml / @enduml genera un diagrama independiente.
' Para exportar los cinco diagramas: plantuml -charset UTF-8 -tsvg clases-cloudgaming.puml
' Los nombres y tipos respetan el código, incluyendo getAll, Sesión y double/decimal.
' No se duplican campos de respaldo de propiedades ni código generado de WinForms.

@startuml 01_entidades
title CloudGaming — Capa de entidades
skinparam backgroundColor white
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #B0E3E6
skinparam classBorderColor #0E8088
skinparam ArrowColor #000000
skinparam defaultFontName Arial
skinparam defaultFontSize 13
hide circle
skinparam classFontStyle bold
skinparam classAttributeFontStyle plain
skinparam roundcorner 0
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 95
class JugadorEntity {
  + EsAdmin : bool {readOnly}
  + NombreUsuario : string
  + NombreApellido : string
  + Mail : string
  + SaldoDisponible : double
  --

}
class SesionEntity {
  + IdSesion : int
  + JuegoId : int
  + ServidorId : int
  + NombreUsuario : string
  + HorasReservadas : double
  + MontoTotal : double
  + InicioUtc : DateTime?
  + FinUtc : DateTime?
  + PuntosConsumidos : int?
  + CapacidadPuntosServidor : int
  + PrecioHoraServidor : double
  + PorcentajeDescuento : double
  --

}
class JuegoEntity {
  + IdJuego : int
  + Titulo : string
  + Resolucion : string
  + Configuracion : string
  + CostoPuntos : int
  --

}
class ServidorEntity {
  + IdServidor : int
  + Gpu : string
  + Cpu : string
  + Ram : string
  + PrecioHora : double
  + PuntosOcupados : int
  + CapacidadPuntos : int
  + PuntosLibres : int
  + Estado : string
  --

}
JugadorEntity "1" -right-> "0..*" SesionEntity
SesionEntity "0..*" <-right- "1" JuegoEntity
SesionEntity "0..*" <-right- "1" ServidorEntity
ServidorEntity -[hidden]down- JuegoEntity

@enduml

